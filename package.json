{
  "name": "paperlens",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "description": "PaperLens - 论文精读 + 知识图谱：单页切换原文/精读/图解与概念图谱，本地论文库，可配置任意 OpenAI 兼容模型 API",
  "author": "xmcchv",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "check": "node scripts/check.mjs",
    "css:scope": "node scripts/scope-css.mjs",
    "migrate:papertrans": "node scripts/migrate-papertrans.mjs",
    "encrypt:translate-keys": "node scripts/encrypt-translate-keys.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:translate-config": "node scripts/test-translate-config.mjs",
    "test:ask-context": "node scripts/test-ask-context.mjs",
    "desktop": "electron .",
    "desktop:build": "node scripts/desktop-build.mjs --dir",
    "desktop:dist": "node scripts/desktop-build.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.paperlens.app",
    "productName": "PaperLens",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "tools/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
